# 必填：从 Cesium ion 创建自己的浏览器用 token。不要填写服务端密钥。
VITE_CESIUM_ION_TOKEN=

# 可选：留空这两项即使用浏览器 IndexedDB 本地保存。
# 云端同步仍在测试；只应填写独立项目的 URL 与 publishable key。
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Globe 视觉与开发调试开关。普通本地体验可保持以下默认示例。
VITE_ENABLE_PROVISIONAL_CITY_BOUNDARIES=false
VITE_SHOW_CITY_BOUNDARY_ALIGNMENT_DEBUG=false
VITE_ENABLE_MINIMAL_GLOBE_STYLE=false
VITE_GLOBE_STYLE=satellite
VITE_RETRO_ATLAS_TEXTURE_MODE=remastered
VITE_RETRO_SHOW_MOUNTAINS=true
VITE_RETRO_MOUNTAINS_OPACITY=0.28
VITE_RETRO_SHOW_TERRAIN_LINES=true
VITE_RETRO_TERRAIN_LINES_OPACITY=0.11
VITE_RETRO_SHOW_GRATICULE=true
VITE_RETRO_GRATICULE_OPACITY=0.07
VITE_DEBUG_GLOBE_PERF=false
VITE_DEBUG_PHOTO_STORAGE=false
VITE_DEBUG_STORAGE_WRITES=false

# VITE_ 变量会进入浏览器构建；绝不要在这里放 service_role 或其他服务端密钥。
